# Contact form endpoint (optional)
#
# When this is set to a REAL Formspree endpoint, the contact form submits
# directly through Formspree:
#   VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/abcdwxyz
#
# When it is unset, empty, or still a placeholder value, the form instead
# falls back to a mailto: flow — submitting opens the visitor's email client
# with the subject and body pre-filled from the form fields, addressed to the
# business contact email. No backend is required for the fallback.
#
# Copy this file to `.env` and fill in your endpoint to enable Formspree.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
